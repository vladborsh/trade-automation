# signal-server — environment template. NAMES AND SAFE DEFAULTS ONLY; never put a real value here.
#
#   cp apps/signal-server/.env.example apps/signal-server/.env   # .env is gitignored — never commit it
#
# The server reads `.env` from its working directory, so start it from apps/signal-server/ (or
# with `npm start -w @trade-automation/signal-server`, which does that). Every key is
# zod-validated at boot (src/config/env.schema.ts): an invalid value is a boot failure.
#
# EVERY LINE BELOW IS COMMENTED OUT, so a fresh copy boots exactly like no .env at all: replay
# fixtures, file store, no database, no login. Uncomment a key only once you give it a value —
# an empty `KEY=` is a value, not "unset", and it overrides the default.
#   [needed for …]  no usable default; the feature named stays off until you set it
#   [optional]      the value shown is the default; leave it commented unless you change it
#
# Slots (AGENTS.md "Working in a worktree"): PORT, APP_BASE_URL, CORS_ORIGIN and the database are
# per slot.

# ── Runtime ────────────────────────────────────────────────────────────────────────────────
# [optional] development | test | production.
# NODE_ENV=development
# [optional] HTTP + WS port. 3000 is the coordinator slot; dev-1 3010, dev-2 3020, dev-3 3030, Tester 3040.
# PORT=3000
# [optional] trace | debug | info | warn | error.
# LOG_LEVEL=info
# [optional] Config files, relative to apps/signal-server/.
# INSTRUMENTS_FILE=config/instruments.yaml
# STRATEGIES_FILE=config/strategies.yaml
# LAYOUTS_FILE=config/layouts.yaml
# [needed for the chart-client dev server] Read by main.ts, not by the zod schema. When the SPA
# is served by `ng serve` on another port (:4200 coordinator, :4210 dev-1, …) the browser
# enforces CORS; set this to that origin, e.g. http://localhost:4210. Unset = CORS off, and the
# SPA shows "Cannot reach the server". Leave unset in production, where the client is same-origin.
# CORS_ORIGIN=

# ── Market data ────────────────────────────────────────────────────────────────────────────
# [optional] replay = bundled fixtures, no credentials, no network. live = real venues.
# MARKET_DATA_MODE=replay
# [optional] Fixtures directory for replay mode.
# REPLAY_FIXTURES_DIR=test/fixtures
# [optional] fast | realtime.
# REPLAY_SPEED=fast
# [optional] Binance USDⓈ-M futures (keyless public endpoints).
# BINANCE_WS_BASE_URL=wss://fstream.binance.com
# BINANCE_REST_BASE_URL=https://fapi.binance.com
# [optional] Metric (OI / long-short) poll cadence in ms, aligned to the 1m bar clock.
# METRIC_POLL_INTERVAL_MS=60000

# ── Capital.com (only MARKET_DATA_MODE=live with a capitalcom instrument) ───────────────────
# [needed for non-crypto live data] SECRETS, all three together. Where: the OWNER's Capital.com
# account → Settings → API integrations (API key + the account login/e-mail + the key's custom
# password). The key used on the old machine was disabled/expired (`error.null.client.token`) —
# it must be re-issued there. Without them crypto instruments still work.
# CAPITAL_COM_IDENTIFIER=
# CAPITAL_COM_PASSWORD=
# CAPITAL_COM_API_KEY=
# [optional]
# CAPITAL_COM_BASE_URL=https://api-capital.backend-capital.com

# ── Storage ────────────────────────────────────────────────────────────────────────────────
# [optional] file | s3.
# CANDLE_STORE=file
# [optional] Root of the file store, relative to apps/signal-server/. Booting WRITES here (a
# boot against real data is not read-only).
# FILE_STORE_ROOT=data
# [needed for CANDLE_STORE=s3] Bucket name. Not a secret, but environment-specific; AWS
# credentials come from the standard AWS chain (profile / instance role), never from this file.
# S3_BUCKET=
# [optional]
# S3_REGION=eu-central-1
# [optional] A local S3-compatible stand-in (MinIO) for tests; unset = real AWS.
# S3_ENDPOINT=
# [optional] file | s3. Unset = whatever CANDLE_STORE is.
# SCREENSHOT_STORE=
# [optional] Upload limit: a screenshot wider than this is refused (400).
# SCREENSHOT_MAX_WIDTH_PX=1280

# ── Database (backtest app) ────────────────────────────────────────────────────────────────
# [needed for login, sessions, the backtest app] NO DEFAULT ON PURPOSE: unset disables DbModule
# (authenticated routes answer 503, the auth guard passes through). Point it at YOUR slot's
# database only — backtest_coord, backtest_dev1, backtest_dev2, backtest_dev3, backtest_tester.
# The local role `backtest`/`backtest` is the shared local Postgres convention, not a secret.
# DATABASE_URL=postgresql://backtest:backtest@localhost:5432/backtest_<slot>
# [optional] Apply pending migrations at boot. `npm run migrate` does the same standalone.
# DB_MIGRATE_ON_BOOT=true
# [needed for login] The admin account upserted at boot; without both nobody can log in.
# ADMIN_PASSWORD is a SECRET, at least 10 characters. Where: the owner (or you, on a local slot)
# chooses them; they never leave this machine's .env.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# [optional] This server's public origin, used to build invite links. Per slot: http://localhost:3010 for dev-1, …
# APP_BASE_URL=http://localhost:3000
# [optional] `Secure` on the bt_session cookie. Unset = true when NODE_ENV=production, else false.
# SESSION_COOKIE_SECURE=false
# [optional] Shared token gate on the WS endpoint (?token=). Applies ONLY when DATABASE_URL is
# unset; with a database the WS checks the bt_session cookie. SECRET if used — you choose it.
# WS_SHARED_TOKEN=

# ── Economic calendar (ForexFactory weekly feed, keyless) ───────────────────────────────────
# [optional] false turns the module off: no polling, /api/calendar/* answers 503.
# CALENDAR_ENABLED=true
# [optional]
# CALENDAR_FEED_BASE_URL=https://nfs.faireconomy.media/ff_calendar_thisweek
# [optional] Poll cadence (ms), and the faster one around high-impact events.
# CALENDAR_POLL_INTERVAL_MS=600000
# CALENDAR_POLL_HOT_INTERVAL_MS=120000
# [optional] Days of stored calendar events loaded into the in-memory cache at boot.
# CALENDAR_CACHE_LOOKBACK_DAYS=400
# [optional] Daily digest time (HH:MM) in CALENDAR_DIGEST_TZ.
# CALENDAR_DIGEST_TIME=00:00
# CALENDAR_DIGEST_TZ=America/New_York
# [optional] low | medium | high — the lowest impact that notifies.
# CALENDAR_NOTIFY_MIN_IMPACT=low
# [optional] Empty = every currency; else a list such as USD,EUR,GBP.
# CALENDAR_NOTIFY_COUNTRIES=
# [optional] Catch-up window (ms) for due-event notifications missed while the server was down.
# CALENDAR_DUE_CATCHUP_MS=900000
