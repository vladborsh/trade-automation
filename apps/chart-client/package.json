{
  "name": "chart-client",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve chart-client",
    "build": "ng build chart-client",
    "watch": "ng build --watch --configuration development",
    "test": "npm run test:chart-client && npm run test:insight-dashboard",
    "mock-server": "tsx watch mock-server/server.ts",
    "mock-server:once": "tsx mock-server/server.ts",
    "e2e": "playwright test",
    "e2e:insight-dashboard": "playwright test -c playwright.insight-dashboard.config.ts",
    "test:chart-client": "NODE_OPTIONS=\"$NODE_OPTIONS --no-experimental-webstorage\" ng test chart-client --watch=false",
    "test:insight-dashboard": "NODE_OPTIONS=\"$NODE_OPTIONS --no-experimental-webstorage\" ng test insight-dashboard --watch=false",
    "build:insight-dashboard": "ng build insight-dashboard",
    "start:insight-dashboard": "ng serve insight-dashboard"
  },
  "private": true,
  "packageManager": "npm@11.13.0",
  "dependencies": {
    "@trade-automation/calendar-core": "0.1.0",
    "@trade-automation/contracts": "0.1.0",
    "@trade-automation/market-data-core": "0.1.0",
    "@trade-automation/indicators": "0.1.0",
    "@trade-automation/replay-core": "0.1.0",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "lightweight-charts": "^5.2.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.0",
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.12",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "tsx": "^4.19.0",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8",
    "ws": "^8.18.0"
  }
}
