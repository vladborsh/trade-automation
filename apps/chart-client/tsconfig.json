/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "compileOnSave": false,
  "compilerOptions": {
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    /*
     * IB-030 (design §3, risk §8.1) — the insight-dashboard project imports the backtest SPA's
     * shared core through this alias instead of copying or forking it. Kept to the pieces that are
     * genuinely app-agnostic (`ApiError`, `AppConfigService`); anything backtest-specific is
     * generalised in place with its own spec rather than aliased into the dashboard.
     */
    "paths": {
      "@backtest-core/*": ["./src/app/core/*"],
      /*
       * IB-031 adds a second alias for the same reason the first exists. The instrument view
       * draws open interest with the backtest SPA's `MetricSeriesRenderer` **unchanged** — that
       * is why the server serves OI in the `MetricPoint` wire shape — and a renderer is a
       * `features/` file, not a `core/` one. The alternative was a five-level relative path out
       * of `projects/`, which breaks the moment either tree moves.
       *
       * The same rule applies as to `@backtest-core/*`: alias what is genuinely reusable as is,
       * generalise in place when it is not, never fork.
       */
      "@backtest-features/*": ["./src/app/features/*"]
    },
    "module": "preserve"
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true
  },
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    }
  ]
}
