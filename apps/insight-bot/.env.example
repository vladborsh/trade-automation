# insight-bot — environment template. NAMES AND SAFE DEFAULTS ONLY; never put a real value here.
#
#   cp apps/insight-bot/.env.example apps/insight-bot/.env     # .env is gitignored — never commit it
#
# The app reads `.env` from its working directory, so start it from apps/insight-bot/ (or with
# `npm start -w @trade-automation/insight-bot`, which does that). Every key is zod-validated at
# boot (src/config/env.schema.ts): an invalid value is a boot failure, not a warning.
#
# EVERY LINE BELOW IS COMMENTED OUT, so a fresh copy boots exactly like no .env at all: no
# database, no bot, every default. Uncomment a key only once you give it a value — an empty
# `KEY=` is a value, not "unset", and it overrides the default.
#   [needed for …]  no usable default; the feature named stays off until you set it
#   [optional]      the value shown is the schema default; leave it commented unless you change it
#
# Slots (AGENTS.md "Working in a worktree"): PORT, the database and WEB_BASE_URL are per slot.
# Production (the Tokyo box) gets its .env rendered from SSM /insight-bot/* by
# infra/insight-bot/scripts/render-env.sh — this file is for local development.

# ── Runtime ────────────────────────────────────────────────────────────────────────────────
# [optional] development | test | production.
# NODE_ENV=development
# [optional] HTTP port. 3005 is the coordinator slot; dev-1 3015, dev-2 3025, dev-3 3035, Tester 3045.
# PORT=3005
# [optional] trace | debug | info | warn | error.
# LOG_LEVEL=info
# [optional] The hand-revised instrument universe, relative to apps/insight-bot/. Missing or
# invalid file = boot failure.
# UNIVERSE_FILE=config/universe.yaml

# ── Database ───────────────────────────────────────────────────────────────────────────────
# [needed for accounts, logins, the liquidation tape, the calendar] NO DEFAULT ON PURPOSE: unset
# disables DbModule and the app still boots (/healthz, /metrics). Point it at YOUR slot's
# database only — insight_coord, insight_dev1, insight_dev2, insight_dev3, insight_tester. The
# local role `backtest`/`backtest` is the shared local Postgres convention (docs/RESTORE-NEW-MACHINE.md),
# not a secret; on the box the URL comes from SSM.
# DATABASE_URL=postgresql://backtest:backtest@localhost:5432/insight_<slot>
# [optional] Apply pending migrations at boot. `npm run migrate` does the same standalone.
# DB_MIGRATE_ON_BOOT=true

# ── Telegram ───────────────────────────────────────────────────────────────────────────────
# [needed for the member bot] SECRET. Without it the bot does not start; the app still runs.
# Where: the OWNER issues it — @BotFather → /newbot. One TEST bot per slot, kept in that slot's
# .env; the one production bot's token lives only in SSM /insight-bot/TELEGRAM_BOT_TOKEN and
# never in a local file (two processes polling one token steal each other's updates).
# TELEGRAM_BOT_TOKEN=
# [optional] The bot's username without "@". Shapes the t.me/<bot>?start=<code> invite link and
# names the bot for the Telegram Login Widget (IB-072); set it to the bot that token belongs to.
# TELEGRAM_BOT_USERNAME=insight_bot
# [needed for service alerts] The chat the bot posts operator messages to (watchdog silence, only
# with OPS_TELEGRAM_ALERTS=true). Unset = those messages are only logged. Where: the owner's own chat with
# the bot (or a group the bot is in) — the numeric chat id, e.g. from @userinfobot.
# TELEGRAM_SERVICE_CHAT_ID=
# [needed for admin commands] The owner's numeric Telegram user id, bootstrapped as admin on
# boot. 0 = no admin: /invite and /users answer nobody. Where: @userinfobot, or the owner knows it.
# ADMIN_TG_USER_ID=0

# ── Web dashboard ──────────────────────────────────────────────────────────────────────────
# [needed for the site] Where the dashboard is served. Empty = not deployed: /web and /password
# refuse rather than sending a link to nowhere. Locally: the slot's dashboard dev server
# (http://localhost:4205 coordinator, :4215 dev-1, …); on the box: https://<owner's domain> (IB-074).
# WEB_BASE_URL=
# [optional] `Secure` on the ib_session cookie. false only for local http; MUST be true behind
# HTTPS (the Cloudflare Tunnel on the box, IB-074).
# WEB_COOKIE_SECURE=false
# [optional] IB-078 H6: the request header the client IP is read from, for the login throttle and
# the login journal. Unset (every dev slot) = the socket address; forwarding headers are IGNORED,
# since anyone reaching the app directly could send one. On the box: x-real-ip — Caddy OVERWRITES
# it, so a client cannot forge it. Set but missing on a request → socket address, warned once.
# CLIENT_IP_HEADER=
# [optional] Browser Web Push for calendar reminders (IB-069). All three or none — a partial
# set is a boot failure; none = push is off (logged at boot). PRIVATE is a SECRET.
# Where: generate locally with `npx web-push generate-vapid-keys` (one pair per environment; the
# box's pair lives in SSM /insight-bot/WEB_PUSH_VAPID_*). SUBJECT is `mailto:…` or `https://…`.
# WEB_PUSH_VAPID_PUBLIC=
# WEB_PUSH_VAPID_PRIVATE=
# WEB_PUSH_VAPID_SUBJECT=

# ── Venues (keyless public endpoints; override only to point a probe at a stand-in) ──────────
# There is no replay mode: with a database the liquidation collectors connect to these live
# public streams on boot. All of them are in use — none is deprecated.
# [optional]
# BINANCE_FUTURES_REST_BASE_URL=https://fapi.binance.com
# [optional] A HOST: the collector appends Binance's /market route itself and refuses a path.
# BINANCE_FUTURES_WS_BASE_URL=wss://fstream.binance.com
# [optional]
# BINANCE_SPOT_REST_BASE_URL=https://api.binance.com
# [optional] Bybit linear liquidations stream.
# BYBIT_WS_URL=wss://stream.bybit.com/v5/public/linear
# [optional] OKX public stream (liquidations).
# OKX_WS_URL=wss://ws.okx.com:8443/ws/v5/public
# [optional] OKX REST (settled funding history).
# OKX_REST_BASE_URL=https://www.okx.com
# [optional] Fear & Greed index (keyless).
# FNG_BASE_URL=https://api.alternative.me
# [optional] CoinGecko public API (keyless; no key-only endpoint is called).
# COINGECKO_BASE_URL=https://api.coingecko.com
# [optional] The watchdog alerts once when a stream has been silent this many minutes.
# WATCHDOG_SILENCE_MIN=3
# [optional] Post the watchdog alerts to the service chat. Default false
# (owner ruling 2026-11-03): they are only logged. The calendar notifications are not affected.
# OPS_TELEGRAM_ALERTS=false

# ── Economic calendar (ForexFactory weekly feed, keyless) ───────────────────────────────────
# [optional] false stops the once-a-day fetch and the members' calendar messages.
# CALENDAR_ENABLED=true
# IB-112: the OI divergence alert loop (journal always; Telegram only when the admin page's switch is on, default off)
# OI_ALERTS_LOOP_ENABLED=true
# IB-115: the image's commit (12 hex), stamped on every OI research row. The image sets it; production refuses to boot without it.
# BUILD_SHA=dev
# [optional]
# CALENDAR_FEED_BASE_URL=https://nfs.faireconomy.media/ff_calendar_thisweek
# [optional] How often (ms) the collector checks whether today's fetch has happened; a check on a
# collected day makes no request.
# CALENDAR_CHECK_INTERVAL_MS=600000
# [optional] Members' morning digest, UTC, HH:MM.
# CALENDAR_DIGEST_TIME=07:00
# [optional] Reminder this many minutes before an event (1…1440).
# CALENDAR_REMIND_LEAD_MIN=15
# [optional] Days of calendar_events read back at boot to seed the diff.
# CALENDAR_CACHE_LOOKBACK_DAYS=30
