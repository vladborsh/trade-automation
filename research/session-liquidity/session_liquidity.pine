//@version=6
// Session liquidity — sweeps, iFVG and k=3 pivots (visual audit instrument)
//
// Draws, on a live TradingView chart, exactly what the Python engine in
// research/session-liquidity/engine.py detects on cached history, so the user
// can eyeball whether the mechanical definitions match what they see:
//
//   * session rectangles (high / low / time bounds) for Asia, London, NY;
//   * the unswept-level pool from the last 2 days, as horizontal rays;
//   * take-outs of those levels (wick beyond the level is sufficient);
//   * 3-candle FVGs and the CLOSE-through that inverts them (iFVG);
//   * k=3 pivot markers and the break-of-structure closes built on them.
//
// This is an INDICATOR, not a strategy: no orders, no equity curve, nothing to
// over-fit. Read RUNBOOK.md before reading anything off it -- in particular the
// pivot markers are plotted 3 bars back, which is where they actually confirm.
//
// Definitions are the ones pinned in knowledge/session-liquidity.md; the pinned
// mechanical defaults (attribution, confirmation window, iFVG location test)
// are documented in research/session-liquidity/REPORT.md and are mirrored here.

indicator("Session liquidity — sweeps / iFVG / pivots", "SessLiq", overlay = true,
     max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

// ------------------------------------------------------------------ inputs --
grpS = "Sessions (UTC, per knowledge/session-liquidity.md)"
bool  showAsia   = input.bool(true,  "Asia   00:00-08:00",  group = grpS)
bool  showLondon = input.bool(true,  "London 08:00-16:00",  group = grpS)
bool  showNY     = input.bool(true,  "NY     13:00-21:00",  group = grpS)
string sessAsia  = input.session("0000-0800", "Asia window",   group = grpS)
string sessLon   = input.session("0800-1600", "London window", group = grpS)
string sessNY    = input.session("1300-2100", "NY window",     group = grpS)
string tz        = input.string("UTC", "Session timezone", group = grpS,
     tooltip = "The study is defined in UTC. Change only if you know why.")

grpL = "Levels"
int   lookbackH  = input.int(48, "Level lifetime (hours)", minval = 2, maxval = 240,
     group = grpL, tooltip = "Spec: unswept levels from the last 2 days = 48h.")
bool  showRays   = input.bool(true, "Draw unswept level rays", group = grpL)
bool  markSweeps = input.bool(true, "Mark take-outs", group = grpL)

grpF = "iFVG"
bool  showFVG    = input.bool(true, "Draw FVGs", group = grpF)
bool  showIFVG   = input.bool(true, "Mark iFVG inversions (full close-through)", group = grpF)
int   fvgKeep    = input.int(30, "Keep an unfilled FVG for N bars", minval = 5, maxval = 200, group = grpF)

grpP = "Structure"
bool  showPiv    = input.bool(true, "k=3 pivot markers", group = grpP)
bool  showBos    = input.bool(true, "Break-of-structure closes", group = grpP)
int   K          = input.int(3, "Pivot k (left = right)", minval = 1, maxval = 10, group = grpP,
     tooltip = "k=3 is the project convention and matches ta.pivothigh(high,3,3).")

color cAsia = input.color(color.new(#e08b3a, 88), "Asia fill",   group = "Colors")
color cLon  = input.color(color.new(#3f7fbf, 88), "London fill", group = "Colors")
color cNY   = input.color(color.new(#7b5ea7, 88), "NY fill",     group = "Colors")

// --------------------------------------------------------------- utilities --
// One tracked session: accumulates high/low while inside its window, and emits
// the finished rectangle + two levels on the first bar after it closes.
type Sess
    string  name
    color   col
    bool    inS
    float   hi
    float   lo
    int     tStart
    box     bx

var Sess sA = Sess.new("Asia",   cAsia, false, na, na, na, na)
var Sess sL = Sess.new("London", cLon,  false, na, na, na, na)
var Sess sN = Sess.new("NY",     cNY,   false, na, na, na, na)

// Level pool. Parallel arrays: price, is-high-side, expiry bar_index, the ray.
var array<float> lvPx   = array.new_float()
var array<bool>  lvHigh = array.new_bool()
var array<int>   lvExp  = array.new_int()
var array<line>  lvLn   = array.new_line()
var array<string> lvSes = array.new_string()

lifeBars = math.max(1, int(lookbackH * 60 / math.max(1, timeframe.in_seconds() / 60)))

addLevel(float px, bool isHigh, string nm, color col) =>
    // The line is always created (never a na id, which would break the update
    // loop); hiding it is done with a fully transparent colour.
    ln = line.new(bar_index, px, bar_index + 1, px, extend = extend.none,
         color = showRays ? col : color.new(color.gray, 100), width = 1,
         style = line.style_dashed)
    array.push(lvLn, ln)
    array.push(lvPx, px)
    array.push(lvHigh, isHigh)
    array.push(lvExp, bar_index + lifeBars)
    array.push(lvSes, nm)

// Track one session: returns nothing, mutates the Sess object.
track(Sess s, string spec, bool enabled) =>
    if enabled
        bool nowIn = not na(time(timeframe.period, spec, tz))
        if nowIn and not s.inS
            s.inS := true
            s.hi := high
            s.lo := low
            s.tStart := time
            s.bx := box.new(bar_index, high, bar_index, low, bgcolor = s.col,
                 border_color = color.new(s.col, 40), border_width = 1)
        else if nowIn
            s.hi := math.max(s.hi, high)
            s.lo := math.min(s.lo, low)
            box.set_top(s.bx, s.hi)
            box.set_bottom(s.bx, s.lo)
            box.set_right(s.bx, bar_index)
        else if s.inS
            // first bar after the window: the session is complete, publish it
            s.inS := false
            box.set_right(s.bx, bar_index - 1)
            addLevel(s.hi, true,  s.name, color.new(s.col, 20))
            addLevel(s.lo, false, s.name, color.new(s.col, 20))

track(sA, sessAsia, showAsia)
track(sL, sessLon,  showLondon)
track(sN, sessNY,   showNY)

// ------------------------------------------------------- take-out detection --
// A wick beyond the level is enough. A level is retired the moment it is taken
// out (each level is swept at most once), which is what the Python engine does.
bool tookHi = false
bool tookLo = false
float tookHiPx = na
float tookLoPx = na

if array.size(lvPx) > 0
    for i = array.size(lvPx) - 1 to 0
        float px = array.get(lvPx, i)
        bool  ish = array.get(lvHigh, i)
        bool  expired = bar_index > array.get(lvExp, i)
        bool  taken = ish ? high > px : low < px
        if not expired and not taken
            line.set_x2(array.get(lvLn, i), bar_index + 1)
        if expired or taken
            if taken
                if ish
                    tookHi := true
                    tookHiPx := na(tookHiPx) ? px : math.max(tookHiPx, px)
                else
                    tookLo := true
                    tookLoPx := na(tookLoPx) ? px : math.min(tookLoPx, px)
            l = array.get(lvLn, i)
            line.set_color(l, showRays ? (taken ? color.new(color.gray, 45) : color.new(color.gray, 80))
                 : color.new(color.gray, 100))
            line.set_style(l, line.style_dotted)
            array.remove(lvPx, i)
            array.remove(lvHigh, i)
            array.remove(lvExp, i)
            array.remove(lvLn, i)
            array.remove(lvSes, i)

if markSweeps and tookHi
    label.new(bar_index, high, "sweep ▲", yloc = yloc.abovebar, style = label.style_label_down,
         color = color.new(color.red, 25), textcolor = color.white, size = size.tiny,
         tooltip = "session HIGH taken out at " + str.tostring(tookHiPx, format.mintick))
if markSweeps and tookLo
    label.new(bar_index, low, "sweep ▼", yloc = yloc.belowbar, style = label.style_label_up,
         color = color.new(color.teal, 25), textcolor = color.white, size = size.tiny,
         tooltip = "session LOW taken out at " + str.tostring(tookLoPx, format.mintick))

// ------------------------------------------------------------------- FVGs ----
// 3-candle gap attributed to its 3rd bar; inverted when a later bar CLOSES
// fully through the far edge (a poke into the gap is not an inversion).
type Fvg
    box   bx
    float lo
    float hi
    bool  bull
    int   born

var array<Fvg> fvgs = array.new<Fvg>()

bool bullFvg = low > high[2]
bool bearFvg = high < low[2]

if showFVG and bullFvg
    b = box.new(bar_index - 2, low, bar_index + 3, high[2],
         bgcolor = color.new(color.teal, 85), border_color = color.new(color.teal, 55))
    array.push(fvgs, Fvg.new(b, high[2], low, true, bar_index))
if showFVG and bearFvg
    b = box.new(bar_index - 2, low[2], bar_index + 3, high,
         bgcolor = color.new(color.maroon, 85), border_color = color.new(color.maroon, 55))
    array.push(fvgs, Fvg.new(b, high, low[2], false, bar_index))

if array.size(fvgs) > 0
    for i = array.size(fvgs) - 1 to 0
        Fvg f = array.get(fvgs, i)
        bool inverted = f.bull ? close < f.lo : close > f.hi
        if inverted and bar_index > f.born
            if showIFVG
                box.set_bgcolor(f.bx, color.new(f.bull ? color.red : color.green, 70))
                box.set_border_color(f.bx, f.bull ? color.red : color.green)
                box.set_right(f.bx, bar_index)
                label.new(bar_index, close, f.bull ? "iFVG↓" : "iFVG↑",
                     style = f.bull ? label.style_label_down : label.style_label_up,
                     color = color.new(f.bull ? color.red : color.green, 20),
                     textcolor = color.white, size = size.tiny,
                     tooltip = "FVG " + str.tostring(f.lo, format.mintick) + " .. " +
                               str.tostring(f.hi, format.mintick) + " closed through")
            array.remove(fvgs, i)
        else if bar_index - f.born > fvgKeep
            box.delete(f.bx)
            array.remove(fvgs, i)
        else
            box.set_right(f.bx, bar_index + 1)

// -------------------------------------------------------- pivots & structure --
// ta.pivothigh(high, K, K) is the 3-ARGUMENT form; the 2-argument form pivots on
// close and is NOT what research/intraday-mr-smc/indicators.py:fractals() does.
// The value is returned K bars late, which is exactly when it is knowable -- the
// marker is therefore drawn at offset -K, on the bar it actually describes.
float ph = ta.pivothigh(high, K, K)
float pl = ta.pivotlow(low, K, K)

plotshape(showPiv and not na(ph), "pivot high", shape.triangledown, location.absolute,
     color.new(color.red, 0), offset = -K, size = size.tiny)
plotshape(showPiv and not na(pl), "pivot low", shape.triangleup, location.absolute,
     color.new(color.blue, 0), offset = -K, size = size.tiny)

// Local BoS trigger: the first CLOSE beyond the most recently confirmed, still
// unbroken pivot. Retired once broken (each swing breaks at most once). This is
// NOT a bias/CHoCH engine -- see the scope note in knowledge/session-liquidity.md.
var float actHi = na
var float actLo = na
if not na(ph)
    actHi := ph
if not na(pl)
    actLo := pl
bool bosUp = not na(actHi) and close > actHi
bool bosDn = not na(actLo) and close < actLo
if bosUp
    actHi := na
if bosDn
    actLo := na

plotshape(showBos and bosDn, "BoS down", shape.xcross, location.belowbar,
     color.new(color.maroon, 0), size = size.tiny, text = "BoS↓")
plotshape(showBos and bosUp, "BoS up", shape.xcross, location.abovebar,
     color.new(color.green, 0), size = size.tiny, text = "BoS↑")

// ----------------------------------------------------------------- alerts ----
alertcondition(tookHi, "Session high taken out", "Session HIGH swept")
alertcondition(tookLo, "Session low taken out", "Session LOW swept")
