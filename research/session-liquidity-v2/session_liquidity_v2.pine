//@version=6
// Session liquidity v2 — non-overlapping sessions, block-scoped relaxed iFVG
//
// Draws, on a live TradingView chart, exactly what the Python engine in
// research/session-liquidity-v2/engine.py detects on cached history, so the
// user can eyeball whether the mechanical definitions match what they see:
//
//   * NON-OVERLAPPING session rectangles: Asia 00-08, London 08-13, NY 13-21,
//     plus the residual Late block 21-24 which produces NO levels;
//   * the unswept-level pool from the last 48h, as horizontal rays;
//   * take-outs of those levels (a wick beyond the level is sufficient);
//   * 3-candle FVGs and the CLOSE-through that inverts them (iFVG), with the
//     RELAXED location test (the gap need only reach beyond the swept level)
//     and BLOCK-SCOPED timing (both the gap's 3rd bar and the inversion close
//     must fall inside the take-out's own clock block);
//   * the current block's end, so the measurement window is visible.
//
// WHAT CHANGED vs the phase-1 research/session-liquidity/session_liquidity.pine:
//   1. London is 08:00-13:00, not 08:00-16:00 — the London/NY overlap is gone.
//   2. A fourth block, Late 21:00-24:00, is drawn but produces no levels.
//   3. iFVG marking is block-scoped and location-relaxed, and an inversion is
//      only marked as a SWEEP CONFIRMATION when it belongs to a take-out that
//      happened earlier in the same block.
//   4. **All pivot and Break-of-Structure drawing is REMOVED.** The phase-1 BoS
//      mechanic was found defective (research/session-liquidity/corrections/
//      BOS-CORRECTION-NOTE.md) and is quarantined to its own later pass —
//      removed rather than left on the chart looking authoritative.
//
// This is an INDICATOR, not a strategy: no orders, no equity curve, nothing to
// over-fit. Read RUNBOOK.md before reading anything off it.
//
// Definitions are the ones pinned in knowledge/session-liquidity.md (v2 reissue);
// the V1-V8 defaults ledger lives there and is mirrored in this package's
// REPORT.md section 1.

indicator("Session liquidity v2 — sweeps / block-scoped iFVG", "SessLiq v2",
     overlay = true, max_boxes_count = 500, max_lines_count = 500,
     max_labels_count = 500)

// ------------------------------------------------------------------ inputs --
grpS = "Sessions (UTC, non-overlapping — knowledge/session-liquidity.md v2)"
bool  showAsia   = input.bool(true,  "Asia   00:00-08:00  (produces levels)", group = grpS)
bool  showLondon = input.bool(true,  "London 08:00-13:00  (produces levels)", group = grpS)
bool  showNY     = input.bool(true,  "NY     13:00-21:00  (produces levels)", group = grpS)
bool  showLate   = input.bool(true,  "Late   21:00-24:00  (NO levels)",       group = grpS)
string sessAsia  = input.session("0000-0800", "Asia window",   group = grpS)
string sessLon   = input.session("0800-1300", "London window", group = grpS)
string sessNY    = input.session("1300-2100", "NY window",     group = grpS)
string sessLate  = input.session("2100-0000", "Late window",   group = grpS)
string tz        = input.string("UTC", "Session timezone", group = grpS,
     tooltip = "The study is defined in UTC, fixed, no DST. Change only if you know why.")

grpL = "Levels"
int   lookbackH  = input.int(48, "Level lifetime (hours)", minval = 2, maxval = 240,
     group = grpL, tooltip = "V8: unswept levels from the last 2 days = 48h.")
bool  showRays   = input.bool(true, "Draw unswept level rays", group = grpL)
bool  markSweeps = input.bool(true, "Mark take-outs", group = grpL)

grpF = "iFVG (relaxed location, block-scoped timing)"
bool  showFVG    = input.bool(true,  "Draw FVGs", group = grpF)
bool  showIFVG   = input.bool(true,  "Mark iFVG inversions (full close-through)", group = grpF)
bool  onlyConf   = input.bool(false, "Only mark inversions that CONFIRM a take-out", group = grpF,
     tooltip = "On: an iFVG label appears only when a level was taken out earlier " +
               "in the same clock block and this gap reaches beyond that level — " +
               "i.e. exactly what the Python engine counts. Off: every inversion " +
               "is drawn, so you can see what the sweep test is filtering out.")
int   fvgKeep    = input.int(60, "Keep an unfilled FVG for N bars", minval = 5, maxval = 400, group = grpF)

grpW = "Measurement window"
bool  showBlockEnd = input.bool(true, "Shade the current block and mark its end", group = grpW,
     tooltip = "V4: every window — magnitude AND iFVG timing — runs from the " +
               "take-out bar to the last bar of the block it happened in.")

color cAsia = input.color(color.new(#e08b3a, 88), "Asia fill",   group = "Colors")
color cLon  = input.color(color.new(#3f7fbf, 88), "London fill", group = "Colors")
color cNY   = input.color(color.new(#7b5ea7, 88), "NY fill",     group = "Colors")
color cLate = input.color(color.new(#9aa0a6, 92), "Late fill",   group = "Colors")

// --------------------------------------------------------------- utilities --
// One tracked session: accumulates high/low while inside its window, and emits
// the finished rectangle (+ two levels, if it is level-producing) on the first
// bar after it closes.
type Sess
    string  name
    color   col
    bool    makesLevels
    bool    inS
    float   hi
    float   lo
    box     bx

var Sess sA = Sess.new("Asia",   cAsia, true,  false, na, na, na)
var Sess sL = Sess.new("London", cLon,  true,  false, na, na, na)
var Sess sN = Sess.new("NY",     cNY,   true,  false, na, na, na)
var Sess sT = Sess.new("Late",   cLate, false, false, na, na, na)

// Level pool. Parallel arrays: price, is-high-side, expiry bar_index, ray, name.
var array<float>  lvPx   = array.new_float()
var array<bool>   lvHigh = array.new_bool()
var array<int>    lvExp  = array.new_int()
var array<line>   lvLn   = array.new_line()
var array<string> lvSes  = array.new_string()

lifeBars = math.max(1, int(lookbackH * 60 / math.max(1, timeframe.in_seconds() / 60)))

addLevel(float px, bool isHigh, string nm, color col) =>
    // The line is always created (never a na id, which would break the update
    // loop); hiding it is done with a fully transparent colour.
    ln = line.new(bar_index, px, bar_index + 1, px, extend = extend.none,
         color = showRays ? col : color.new(color.gray, 100), width = 1,
         style = line.style_dashed)
    array.push(lvLn, ln)
    array.push(lvPx, px)
    array.push(lvHigh, isHigh)
    array.push(lvExp, bar_index + lifeBars)
    array.push(lvSes, nm)

track(Sess s, string spec, bool enabled) =>
    if enabled
        bool nowIn = not na(time(timeframe.period, spec, tz))
        if nowIn and not s.inS
            s.inS := true
            s.hi := high
            s.lo := low
            s.bx := box.new(bar_index, high, bar_index, low, bgcolor = s.col,
                 border_color = color.new(s.col, 40), border_width = 1,
                 border_style = s.makesLevels ? line.style_solid : line.style_dotted)
        else if nowIn
            s.hi := math.max(s.hi, high)
            s.lo := math.min(s.lo, low)
            box.set_top(s.bx, s.hi)
            box.set_bottom(s.bx, s.lo)
            box.set_right(s.bx, bar_index)
        else if s.inS
            // first bar after the window: the session is complete, publish it
            s.inS := false
            box.set_right(s.bx, bar_index - 1)
            if s.makesLevels
                addLevel(s.hi, true,  s.name, color.new(s.col, 20))
                addLevel(s.lo, false, s.name, color.new(s.col, 20))

track(sA, sessAsia, showAsia)
track(sL, sessLon,  showLondon)
track(sN, sessNY,   showNY)
track(sT, sessLate, showLate)

// ---------------------------------------------------- the current clock block
// Which of the four blocks this bar belongs to, and whether the block just
// changed. Everything block-scoped is reset on that change, which is exactly
// what "the window ends when the block ends" means mechanically.
inAsia = not na(time(timeframe.period, sessAsia, tz))
inLon  = not na(time(timeframe.period, sessLon,  tz))
inNY   = not na(time(timeframe.period, sessNY,   tz))
string curBlock = inAsia ? "Asia" : inLon ? "London" : inNY ? "NY" : "Late"
bool newBlock = curBlock != curBlock[1]

if showBlockEnd and newBlock and not na(curBlock[1])
    line.new(bar_index - 1, low, bar_index - 1, high, extend = extend.both,
         color = color.new(color.olive, 55), style = line.style_dashed, width = 1)
    label.new(bar_index - 1, high, curBlock[1] + " block ends", yloc = yloc.abovebar,
         style = label.style_label_down, color = color.new(color.olive, 75),
         textcolor = color.gray, size = size.tiny,
         tooltip = "V4: every measurement / iFVG window for a take-out inside " +
                   "the previous block stopped here.")

// ------------------------------------------------------- take-out detection --
// A wick beyond the level is enough. A level is retired the moment it is taken
// out (V7: each level is swept at most once), which is what the engine does.
//
// `swHi` / `swLo` remember the levels taken out EARLIER IN THIS BLOCK, so the
// iFVG test below can be block-scoped and location-relaxed exactly as in Python.
var float swHi = na          // highest session-high taken out in this block
var float swLo = na          // lowest session-low taken out in this block
if newBlock
    swHi := na
    swLo := na

bool tookHi = false
bool tookLo = false
float tookHiPx = na
float tookLoPx = na

if array.size(lvPx) > 0
    for i = array.size(lvPx) - 1 to 0
        float px = array.get(lvPx, i)
        bool  ish = array.get(lvHigh, i)
        bool  expired = bar_index > array.get(lvExp, i)
        bool  taken = ish ? high > px : low < px
        if not expired and not taken
            line.set_x2(array.get(lvLn, i), bar_index + 1)
        if expired or taken
            if taken
                if ish
                    tookHi := true
                    // V2 attribution: the deepest level reached wins
                    tookHiPx := na(tookHiPx) ? px : math.max(tookHiPx, px)
                else
                    tookLo := true
                    tookLoPx := na(tookLoPx) ? px : math.min(tookLoPx, px)
            l = array.get(lvLn, i)
            line.set_color(l, showRays ? (taken ? color.new(color.gray, 45) : color.new(color.gray, 80))
                 : color.new(color.gray, 100))
            line.set_style(l, line.style_dotted)
            array.remove(lvPx, i)
            array.remove(lvHigh, i)
            array.remove(lvExp, i)
            array.remove(lvLn, i)
            array.remove(lvSes, i)

if tookHi
    swHi := na(swHi) ? tookHiPx : math.max(swHi, tookHiPx)
if tookLo
    swLo := na(swLo) ? tookLoPx : math.min(swLo, tookLoPx)

if markSweeps and tookHi
    label.new(bar_index, high, "sweep ▲", yloc = yloc.abovebar, style = label.style_label_down,
         color = color.new(color.red, 25), textcolor = color.white, size = size.tiny,
         tooltip = "session HIGH taken out at " + str.tostring(tookHiPx, format.mintick) +
                   "  |  window: this bar -> end of the " + curBlock + " block")
if markSweeps and tookLo
    label.new(bar_index, low, "sweep ▼", yloc = yloc.belowbar, style = label.style_label_up,
         color = color.new(color.teal, 25), textcolor = color.white, size = size.tiny,
         tooltip = "session LOW taken out at " + str.tostring(tookLoPx, format.mintick) +
                   "  |  window: this bar -> end of the " + curBlock + " block")

// ------------------------------------------------------------------- FVGs ----
// 3-candle gap attributed to its 3rd bar; inverted when a later bar CLOSES
// fully through the far edge (a poke into the gap is never an inversion).
//
// `bornBlockOk` records that the gap's 3rd bar printed inside the current
// block; an inversion is only block-scoped-valid while that is still true, so
// a block change invalidates every pending gap — which is V4.
type Fvg
    box   bx
    float lo
    float hi
    bool  bull
    int   born
    bool  sameBlock

var array<Fvg> fvgs = array.new<Fvg>()

bool bullFvg = low > high[2]
bool bearFvg = high < low[2]

if showFVG and bullFvg
    b = box.new(bar_index - 2, low, bar_index + 3, high[2],
         bgcolor = color.new(color.teal, 85), border_color = color.new(color.teal, 55))
    array.push(fvgs, Fvg.new(b, high[2], low, true, bar_index, true))
if showFVG and bearFvg
    b = box.new(bar_index - 2, low[2], bar_index + 3, high,
         bgcolor = color.new(color.maroon, 85), border_color = color.new(color.maroon, 55))
    array.push(fvgs, Fvg.new(b, high, low[2], false, bar_index, true))

if array.size(fvgs) > 0
    for i = array.size(fvgs) - 1 to 0
        Fvg f = array.get(fvgs, i)
        if newBlock
            f.sameBlock := false          // V4: the window closed with the block
        bool inverted = f.bull ? close < f.lo : close > f.hi
        // V5 relaxed location: a bullish gap confirms a HIGH sweep if the gap
        // merely REACHES above the swept level; mirrored for a bearish gap.
        bool confirms = f.bull ? (not na(swHi) and f.hi > swHi)
             : (not na(swLo) and f.lo < swLo)
        bool valid = f.sameBlock and (not onlyConf or confirms)
        if inverted and bar_index > f.born
            if showIFVG and valid
                box.set_bgcolor(f.bx, color.new(f.bull ? color.red : color.green, 70))
                box.set_border_color(f.bx, f.bull ? color.red : color.green)
                box.set_right(f.bx, bar_index)
                label.new(bar_index, close,
                     confirms ? (f.bull ? "iFVG↓ sweep" : "iFVG↑ sweep")
                              : (f.bull ? "iFVG↓" : "iFVG↑"),
                     style = f.bull ? label.style_label_down : label.style_label_up,
                     color = color.new(f.bull ? color.red : color.green, confirms ? 10 : 45),
                     textcolor = color.white, size = size.tiny,
                     tooltip = "FVG " + str.tostring(f.lo, format.mintick) + " .. " +
                               str.tostring(f.hi, format.mintick) + " closed through" +
                               (confirms ? "  |  CONFIRMS a take-out earlier in this " +
                                curBlock + " block" : "  |  no take-out to confirm"))
            else
                box.delete(f.bx)
            array.remove(fvgs, i)
        else if bar_index - f.born > fvgKeep or not f.sameBlock
            box.delete(f.bx)
            array.remove(fvgs, i)
        else
            box.set_right(f.bx, bar_index + 1)

// ----------------------------------------------------------------- alerts ----
alertcondition(tookHi, "Session high taken out", "Session HIGH swept")
alertcondition(tookLo, "Session low taken out",  "Session LOW swept")
