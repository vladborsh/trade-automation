{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PassOnlyTheAlarmRoleAndOnlyToLambda",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::*:role/insight-bot-alarm-telegram",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "lambda.amazonaws.com"
        }
      }
    },
    {
      "Sid": "IB150TheAlarmsOnly",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:PutMetricAlarm",
        "cloudwatch:DeleteAlarms",
        "cloudwatch:TagResource",
        "cloudwatch:UntagResource",
        "cloudwatch:ListTagsForResource"
      ],
      "Resource": "arn:aws:cloudwatch:ap-northeast-1:*:alarm:insight-bot-*"
    },
    {
      "Sid": "IB150ReadOnlyListings",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:DescribeAlarms",
        "logs:DescribeLogGroups"
      ],
      "Resource": "*"
    },
    {
      "Sid": "IB150TheAlarmTopicOnly",
      "Effect": "Allow",
      "Action": [
        "sns:CreateTopic",
        "sns:DeleteTopic",
        "sns:GetTopicAttributes",
        "sns:SetTopicAttributes",
        "sns:Subscribe",
        "sns:Unsubscribe",
        "sns:GetSubscriptionAttributes",
        "sns:SetSubscriptionAttributes",
        "sns:ListSubscriptionsByTopic",
        "sns:TagResource",
        "sns:UntagResource",
        "sns:ListTagsForResource"
      ],
      "Resource": "arn:aws:sns:ap-northeast-1:*:insight-bot-alarms"
    },
    {
      "Sid": "IB150TheLogGroupsOnly",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:DeleteLogGroup",
        "logs:PutRetentionPolicy",
        "logs:DeleteRetentionPolicy",
        "logs:PutMetricFilter",
        "logs:DeleteMetricFilter",
        "logs:DescribeMetricFilters",
        "logs:TagResource",
        "logs:UntagResource",
        "logs:ListTagsForResource",
        "logs:TagLogGroup",
        "logs:UntagLogGroup",
        "logs:ListTagsLogGroup"
      ],
      "Resource": [
        "arn:aws:logs:ap-northeast-1:*:log-group:/insight-bot/*",
        "arn:aws:logs:ap-northeast-1:*:log-group:/insight-bot/*:*",
        "arn:aws:logs:ap-northeast-1:*:log-group:/aws/lambda/insight-bot-alarm-telegram",
        "arn:aws:logs:ap-northeast-1:*:log-group:/aws/lambda/insight-bot-alarm-telegram:*"
      ]
    },
    {
      "Sid": "IB150TheAlarmLambdaOnly",
      "Effect": "Allow",
      "Action": [
        "lambda:CreateFunction",
        "lambda:DeleteFunction",
        "lambda:GetFunction",
        "lambda:GetFunctionConfiguration",
        "lambda:GetFunctionCodeSigningConfig",
        "lambda:GetRuntimeManagementConfig",
        "lambda:GetFunctionRecursionConfig",
        "lambda:GetFunctionConcurrency",
        "lambda:ListVersionsByFunction",
        "lambda:ListFunctionUrlConfigs",
        "lambda:UpdateFunctionCode",
        "lambda:UpdateFunctionConfiguration",
        "lambda:AddPermission",
        "lambda:RemovePermission",
        "lambda:GetPolicy",
        "lambda:PutFunctionEventInvokeConfig",
        "lambda:GetFunctionEventInvokeConfig",
        "lambda:UpdateFunctionEventInvokeConfig",
        "lambda:DeleteFunctionEventInvokeConfig",
        "lambda:TagResource",
        "lambda:UntagResource",
        "lambda:ListTags"
      ],
      "Resource": "arn:aws:lambda:ap-northeast-1:*:function:insight-bot-alarm-telegram"
    },
    {
      "Sid": "IB150TestParametersOutsideTheBoxTree",
      "Effect": "Allow",
      "Action": [
        "ssm:PutParameter",
        "ssm:GetParameter",
        "ssm:DeleteParameter",
        "ssm:AddTagsToResource",
        "ssm:ListTagsForResource"
      ],
      "Resource": "arn:aws:ssm:ap-northeast-1:*:parameter/insight-bot-test/*"
    },
    {
      "Sid": "IB150ReadTheTestEvidence",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:DescribeAlarmHistory",
        "logs:FilterLogEvents"
      ],
      "Resource": [
        "arn:aws:cloudwatch:ap-northeast-1:*:alarm:insight-bot-*",
        "arn:aws:logs:ap-northeast-1:*:log-group:/aws/lambda/insight-bot-alarm-telegram",
        "arn:aws:logs:ap-northeast-1:*:log-group:/aws/lambda/insight-bot-alarm-telegram:*"
      ]
    }
  ]
}
