# The only door into the box (architecture/https-without-domain-2026-11-03.md H1, H3, H7, H8').
# SITE_ADDRESS is <a-b-c-d>.sslip.io, from SSM via caddy.env; Caddy gets and renews the certificate
# for it itself (state on the caddy_data volume, H5) and redirects http to https.
# UPSTREAM is only overridden by the local rehearsal; on the box the app is insight-bot:3005 on the
# compose network and publishes no port.

# IB-BUG-031: the default log carries Caddy's error lines (http.log.error.*, e.g. a 502 while the app
# restarts), each with the request's uri — the site `log` filter below does not reach them. Same
# scrub, so a set-password token never lands in either. JSON, as the default log already writes.
{
	log default {
		output stderr
		format filter {
			wrap json
			fields {
				request>uri query {
					replace t REDACTED
					replace token REDACTED
				}
			}
		}
	}
}

{$SITE_ADDRESS} {
	# H7: the Prometheus endpoint never answers from outside. The app adds its own 404 too (WD-011): any
	# request carrying CLIENT_IP_HEADER (x-real-ip, set below on every proxied request) gets 404.
	@metrics path /metrics /metrics/*
	respond @metrics 404

	# H8': before WD-011 the app's /health served collector internals unauthenticated; since WD-011 the
	# app itself gives /health to the SPA. Kept as the outer layer: the exact path is the dashboard's
	# admin Health page, so it is REWRITTEN to / and the SPA answers — a reload of that page keeps working. The app's router is case-insensitive and
	# accepts a trailing slash (Express defaults), and Caddy's path matcher is case-insensitive, so
	# /health/ is listed explicitly. /healthz (the liveness probe, {status} only) passes through.
	@opsHealth path /health /health/
	rewrite @opsHealth /

	reverse_proxy {$UPSTREAM:insight-bot:3005} {
		# H6: overwrite, never append — a client-sent X-Real-IP must not reach the app's throttle
		# or journal (the app reads CLIENT_IP_HEADER=x-real-ip).
		header_up X-Real-IP {remote_host}
	}

	# IB-BUG-031: the access log keeps the path and never a credential. Caddy already prints Cookie,
	# Set-Cookie and Authorization as REDACTED (log_credentials is off); the URL is ours to scrub:
	# `t` is the one-time set-password token (/set-password?t=…, /api/web/auth/credentials?t=…), a
	# member's password reset for 10 minutes. Same list as SECRET_QUERY_PARAMS in
	# apps/insight-bot/src/ops/http-log.ts — a new secret query parameter goes in both.
	log {
		output stdout
		format filter {
			wrap console
			fields {
				request>uri query {
					replace t REDACTED
					replace token REDACTED
				}
			}
		}
	}
}
