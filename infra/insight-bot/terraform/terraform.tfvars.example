# Copy to terraform.tfvars and fill in. Nothing here is secret: the Telegram tokens and the
# database password live in SSM SecureStrings the user creates (RUNBOOK §4), never in Terraform.

# S3 bucket names are globally unique — pick one with the account id or a suffix.
backup_bucket_name = "vb-insight-bot-backups-apne1"   # the user's name; add a short suffix if taken
budget_alert_email = ""                              # where the 18 USD alert goes; empty = no budget
monitoring_variant = "minimal"                       # IB-150: "full" or "minimal", the owner's choice (cost)
# alarm_email      = ""                              # IB-150: optional e-mail copy of the Telegram alarms

# region                = "ap-northeast-1"
# instance_type         = "t4g.small"
# root_volume_gb        = 50
# deploy_role_github_sub = "repo:vladborsh@11244920/trade-automation@1376010429:ref:refs/heads/master"
# backup_retention_days = 35
